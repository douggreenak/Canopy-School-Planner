{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "src/app/api/powerschool/**/*": {
      "maxDuration": 280
    },
    "src/app/api/powerschool/migrate/**/*": {
      "maxDuration": 60
    }
  },
  "crons": [
    { "path": "/api/powerschool/cron", "schedule": "0 12 * * *" }
  ]
}
